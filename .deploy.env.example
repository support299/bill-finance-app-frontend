# Copy to .deploy.env (git-ignored) and fill in. Used by `npm run deploy`.
DEPLOY_HOST=app.example.com            # EC2 public IP / Elastic IP, or your domain
DEPLOY_USER=ubuntu                     # ubuntu for Ubuntu AMIs, ec2-user for Amazon Linux
DEPLOY_KEY=~/.ssh/my-ec2-key.pem       # path to the key pair you downloaded when creating the instance
DEPLOY_PATH=/var/www/imax              # must be writable by DEPLOY_USER (the setup steps create it)
API_BASE_URL=https://app.example.com/api/v1   # baked into the build as VITE_API_BASE_URL
